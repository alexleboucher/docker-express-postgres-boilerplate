{
  "name": "docker-express-boilerplate",
  "version": "3.0.0",
  "private": true,
  "description": "A boilerplate for Express.js applications with Docker, PostgreSQL, and a pre-built authentication system.",
  "main": "build/app/index.js",
  "author": "Alexis Le Boucher",
  "license": "MIT",
  "scripts": {
    "start": "node build/app/index.js",
    "dev": "nodemon -L -r tsconfig-paths/register src/app/index.ts --watch \"src/**/*.{ts,js}\"",
    "build": "tsc -p tsconfig.build.json && tsc-alias",
    "type-check": "tsc --noEmit",
    "lint:fix": "eslint --fix \"src/**/*.{ts,js}\"",
    "lint": "eslint \"src/**/*.{ts,js}\"",
    "test": "NODE_ENV=test yarn migration:run && jest --runInBand",
    "test:coverage": "NODE_ENV=test yarn migration:run && jest --runInBand --collectCoverage",
    "docker:up": "docker-compose --profile dev up -d && yarn docker:shell",
    "docker:test:up": "docker-compose --profile test up -d && yarn docker:shell",
    "docker:down": "docker-compose --profile dev --profile test down",
    "docker:shell": "docker exec -it backend sh || true",
    "docker:build": "docker build . -t backend",
    "migration:generate": "sh -c 'yarn drizzle-kit generate --config=./src/infra/database/config/drizzle.config.ts --name=$0'",
    "migration:run": "yarn drizzle-kit migrate --config=./src/infra/database/config/drizzle.config.ts"
  },
  "dependencies": {
    "bcryptjs": "3.0.3",
    "cors": "2.8.6",
    "dotenv": "17.4.2",
    "drizzle-kit": "^1.0.0-rc.4",
    "drizzle-orm": "^1.0.0-rc.4",
    "express": "5.2.1",
    "helmet": "8.2.0",
    "inversify": "8.1.1",
    "jsonwebtoken": "9.0.3",
    "morgan": "1.11.0",
    "pg": "8.22.0",
    "reflect-metadata": "0.2.2",
    "tslib": "2.8.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "4.7.2",
    "@eslint/js": "10.0.1",
    "@stylistic/eslint-plugin": "5.10.0",
    "@types/bcryptjs": "3.0.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/jsonwebtoken": "9.0.10",
    "@types/morgan": "1.9.10",
    "@types/node": "26.0.1",
    "@types/pg": "8.20.0",
    "@types/supertest": "7.2.0",
    "eslint": "10.6.0",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "jest": "30.4.2",
    "jest-mock-extended": "4.0.1",
    "nodemon": "3.1.14",
    "supertest": "7.2.2",
    "ts-jest": "29.4.11",
    "ts-node": "10.9.2",
    "tsc-alias": "1.8.17",
    "tsconfig-paths": "4.2.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.62.1"
  }
}
